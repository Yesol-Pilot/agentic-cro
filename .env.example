# ==========================================
# Agentic CRO: Environment Configuration
# ==========================================
# * 하드코딩 금지 정책에 따라, 에이전트는 모든 식별자 및 키를 여기서 주입받습니다.

# 1. MCP Server Endpoints & Credentials
POSTHOG_API_KEY="your_posthog_personal_api_key_here"
POSTHOG_PROJECT_ID="your_posthog_project_id"
POSTHOG_HOST="https://app.posthog.com"

GITHUB_PAT="your_github_classic_or_fine_grained_token"
REPO_OWNER="your_github_username"
REPO_NAME="agentic-cro"

V0_API_TOKEN="your_v0_dev_api_token"
GROWTHBOOK_API_KEY="your_growthbook_api_key"

# 2. Mathematical Validation Thresholds
# 베이지안 기대손실 최대 허용치 (0.0015 = 0.15% 수익 감소 오차)
MAX_EXPECTED_LOSS="0.0015"
# 베이지안 최소 승리 확률 신뢰도 (95%)
MIN_CONFIDENCE_LEVEL="0.95"

# 3. Execution Engine Config
# 에이전트 다중 오케스트레이션 구동 타임아웃
AGENT_MESH_TIMEOUT_MS="120000"
# 에이전트 최대 가설 생성 및 재시도 횟수
MAX_RETRY_ATTEMPTS="3"

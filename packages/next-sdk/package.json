{
  "name": "@agentic-cro/next-sdk",
  "version": "1.0.0",
  "description": "Enterprise API & Telemetry SDK for Agentic CRO Hive Mind",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/server.ts src/cli.ts --format cjs,esm --dts --watch"
  },
  "bin": {
    "agentic-cro": "./dist/cli.js"
  },
  "dependencies": {
    "@growthbook/growthbook-react": "^0.22.0",
    "posthog-js": "^1.116.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "author": "Antigravity",
  "license": "MIT"
}